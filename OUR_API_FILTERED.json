    {
        "question_ref": "ENV_EMI_MGT_Q1",
        "period_month": null,
        "value_text": "ElevenLabs is committed to minimizing the carbon footprint of our AI models. Our direct emissions (Scope 1 and 2) are extremely low as we operate entirely out of a single leased office. Our primary emissions are Scope 3, specifically from cloud computing (AWS and GCP) used for training and running inference for our Text-to-Speech (TTS) models. We actively prioritize cloud regions powered by renewable energy and optimize our GPU compute utilization.",
        "value_number": null,
        "value_json": null,
        "unit_key": null
    },
    {
        "question_ref": "ENV_EMI_MGT_Q2",
        "period_month": null,
        "value_text": "Effectiveness is tracked via cloud provider carbon dashboards and API inference efficiency metrics (compute per 1M characters). The engineering team reviews compute intensity monthly to optimize model efficiency and reduce associated energy use.",
        "value_number": null,
        "value_json": null,
        "unit_key": null
    },
