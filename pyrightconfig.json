{
    "include": [
        "."
    ],
    "exclude": [
        "**/__pycache__",
        "**/.venv",
        "**/venv",
        "**/node_modules"
    ],
    "venvPath": ".",
    "venv": ".venv",
    "pythonVersion": "3.14",
    "typeCheckingMode": "basic",
    "reportMissingImports": true,
    "reportMissingTypeStubs": false,
    "useLibraryCodeForTypes": true
}